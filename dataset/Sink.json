{
	"name": "Sink",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS",
			"type": "LinkedServiceReference",
			"parameters": {
				"envVaultUrl": {
					"value": "@dataset().dsKeyVaultURL",
					"type": "Expression"
				},
				"storageAccountUrl": "@dataset().dsStorageURL"
			}
		},
		"parameters": {
			"dsKeyVaultURL": {
				"type": "string",
				"defaultValue": "https://azure.net"
			},
			"dsStorageURL": {
				"type": "string",
				"defaultValue": "https://stdevtrial.dfs.core.windows.net/"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": "text.csv",
				"fileSystem": "output"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}